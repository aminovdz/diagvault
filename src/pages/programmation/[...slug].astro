---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const programmationEntries = await getCollection('programmation');
  const ecuEntries = await getCollection('ecu');
  const eepromEntries = await getCollection('eeprom');
  const immoEntries = await getCollection('immo');

  const allEntries = [
    ...programmationEntries,
    ...ecuEntries,
    ...eepromEntries,
    ...immoEntries
  ];

  return allEntries.map(entry => ({
    params: { slug: `${entry.collection}/${entry.id}` },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<ArticleLayout frontmatter={entry.data} headings={headings}>
  <Content />
</ArticleLayout>
