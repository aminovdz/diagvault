---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch a few articles to display on the homepage
const symptomes = await getCollection('symptomes');
const casreels = await getCollection('casreels');
const capteurs = await getCollection('capteurs');
const electricite = await getCollection('electricite');
const actionneurs = await getCollection('actionneurs');

const allArticles = [...symptomes, ...casreels, ...capteurs, ...electricite, ...actionneurs]
  .sort((a, b) => new Date(b.data.published_date || 0).getTime() - new Date(a.data.published_date || 0).getTime())
  .slice(0, 8); // get latest 8
---

<BaseLayout title="DiagVault | Diagnostic Automobile & Programmation ECU">
  <!-- Hero Section -->
  <section class="py-16 md:py-24 max-w-4xl mx-auto text-center">
    <div class="inline-block px-3 py-1 mb-6 rounded-full bg-slate-800 border border-slate-700 text-sm font-semibold tracking-wider text-accent-diagnostic">
      BASE DE CONNAISSANCES TECHNIQUE
    </div>
    <h1 class="text-4xl md:text-6xl font-heading font-black text-white mb-6 leading-tight">
      Dépanner avec Logique.<br/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-diagnostic to-blue-400">Pas au Hasard.</span>
    </h1>
    <p class="text-xl text-slate-400 mb-10">
      Ne remplacez pas une pièce simplement parce que le scanner indique un défaut. Mesurez, testez et confirmez grâce à nos procédures étape par étape.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <form action="/recherche" class="relative max-w-md w-full">
        <input name="q" type="text" placeholder="Rechercher un symptôme, un code, un capteur..." class="w-full bg-surface border border-slate-700 rounded-lg py-3 px-5 text-white focus:outline-none focus:border-accent-diagnostic focus:ring-1 focus:ring-accent-diagnostic transition-all" />
        <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-accent-diagnostic">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
      </form>
    </div>
  </section>

  <!-- NOUVEAUX GUIDES SECTION (Dynamic) -->
  <section class="py-12 border-t border-slate-800">
    <div class="flex justify-between items-end mb-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-white">Ajouts Récents ({allArticles.length} guides)</h2>
      <a href="/recherche" class="text-sm text-accent-diagnostic hover:underline">Voir toute la base →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {allArticles.map(article => (
        <a href={`/diagnostic/${article.collection}/${article.id}`} class="block p-5 bg-surface border border-slate-800 rounded-xl hover:border-slate-500 transition-colors flex flex-col h-full">
          <div class="text-xs text-slate-500 mb-2 uppercase tracking-wider">{article.collection}</div>
          <h3 class="text-md font-bold text-white mb-2 leading-snug">{article.data.title}</h3>
          <p class="text-sm text-slate-400 line-clamp-3 mt-auto">{article.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Piliers Section -->
  <section class="py-12 border-t border-slate-800">
    <h2 class="text-2xl md:text-3xl font-heading font-bold text-white mb-8 text-center">Toutes les Catégories</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- New categories from user prompt -->
      <a href="/diagnostic/symptomes" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors">Symptômes</h3>
        <p class="text-sm text-slate-400">Voiture ne démarre pas, ralenti instable, voyants allumés. Arbres de diagnostic logiques.</p>
      </a>

      <a href="/diagnostic/casreels" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors">Cas Réels</h3>
        <p class="text-sm text-slate-400">Études de cas réels. Symptôme, codes défauts, pièges et méthode de résolution.</p>
      </a>

      <a href="/diagnostic/capteurs" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors">Capteurs & Actionneurs</h3>
        <p class="text-sm text-slate-400">PMH, Lambda, MAP, MAF. Valeurs de test et procédures au multimètre/oscilloscope.</p>
      </a>

      <a href="/diagnostic/electricite" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors">Électricité & Faisceaux</h3>
        <p class="text-sm text-slate-400">Tests de masses, alimentations, chutes de tension et courts-circuits.</p>
      </a>

      <a href="/diagnostic/can" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors">Réseaux CAN Bus</h3>
        <p class="text-sm text-slate-400">Diagnostic des pannes de communication, résistance 60 ohms, signal CAN High/Low.</p>
      </a>

      <a href="/diagnostic/dtc" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors">Codes Défauts (DTC)</h3>
        <p class="text-sm text-slate-400">Plus qu'une simple définition : les causes réelles et les contrôles à effectuer par code.</p>
      </a>

      <!-- Programmation -->
      <a href="/programmation/ecu" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-programmation transition-colors">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-programmation transition-colors">Programmation ECU</h3>
        <p class="text-sm text-slate-400">OBD, Bench, Boot. Clonage de calculateurs et codage des modules.</p>
      </a>

      <a href="/outils" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-programmation transition-colors">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-programmation transition-colors">Matériel & Outils</h3>
        <p class="text-sm text-slate-400">Tests, avis et comparatifs de scanners, oscilloscopes et programmateurs. Ce qu'ils font vraiment.</p>
      </a>

    </div>
  </section>
</BaseLayout>
