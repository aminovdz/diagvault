---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch a few articles to display on the homepage
const symptomes = await getCollection('symptomes');
const methodologie = await getCollection('methodologie');
const casreels = await getCollection('casreels');
const capteurs = await getCollection('capteurs');
const electricite = await getCollection('electricite');
const actionneurs = await getCollection('actionneurs');

const allArticles = [...symptomes, ...casreels, ...methodologie, ...capteurs, ...electricite, ...actionneurs]
  .sort((a, b) => new Date(b.data.published_date || 0).getTime() - new Date(a.data.published_date || 0).getTime())
  .slice(0, 8); // get latest 8
---

<BaseLayout title="DiagVault | Diagnostic Automobile & Programmation ECU">
  <!-- Hero Section -->
  <section class="py-16 md:py-24 max-w-4xl mx-auto text-center">
    <div class="inline-block px-3 py-1 mb-6 rounded-full bg-slate-800 border border-slate-700 text-sm font-semibold tracking-wider text-accent-diagnostic">
      BASE DE CONNAISSANCES TECHNIQUE
    </div>
    <h1 class="text-4xl md:text-6xl font-heading font-black text-white mb-6 leading-tight">
      Dépanner avec Logique.<br/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-diagnostic to-blue-400">Pas au Hasard.</span>
    </h1>
    <p class="text-xl text-slate-400 mb-10">
      L'outil de référence pour les professionnels. Diagnostics pas-à-pas, Live Data, et contrôles électriques pour trouver la vraie panne.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <form action="/recherche" class="relative max-w-md w-full">
        <input name="q" type="text" placeholder="Ex: P0301, Capteur PMH, U0100..." class="w-full bg-surface border border-slate-700 rounded-lg py-3 px-5 text-white focus:outline-none focus:border-accent-diagnostic focus:ring-1 focus:ring-accent-diagnostic transition-all" />
        <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-accent-diagnostic">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
      </form>
    </div>
  </section>

  <!-- NOUVELLE SECTION : Quel est votre problème ? (Parcours Symptôme) -->
  <section class="py-12 border-t border-slate-800">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-white mb-6 flex items-center gap-3">
        <span>🔎</span> Quel est votre problème ?
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <a href="/diagnostic/symptomes/panne-moteur-ne-demarre-pas-diagnostic-generique-toutes-marques" class="flex items-center gap-3 p-4 bg-slate-800/50 hover:bg-slate-800 rounded-lg border border-slate-700 hover:border-accent-diagnostic transition-colors">
          <span class="text-accent-diagnostic text-xl">⚡</span>
          <span class="text-slate-200 font-medium">La voiture ne démarre pas</span>
        </a>
        <a href="/diagnostic/symptomes/moteur-qui-cale-systematiquement-au-ralenti" class="flex items-center gap-3 p-4 bg-slate-800/50 hover:bg-slate-800 rounded-lg border border-slate-700 hover:border-accent-diagnostic transition-colors">
          <span class="text-accent-diagnostic text-xl">🛑</span>
          <span class="text-slate-200 font-medium">Le moteur cale au ralenti</span>
        </a>
        <a href="/diagnostic/methodologie/comment-diagnostiquer-une-perte-de-puissance-sans-se-tromper-de-piste" class="flex items-center gap-3 p-4 bg-slate-800/50 hover:bg-slate-800 rounded-lg border border-slate-700 hover:border-accent-diagnostic transition-colors">
          <span class="text-accent-diagnostic text-xl">🐢</span>
          <span class="text-slate-200 font-medium">Perte de puissance</span>
        </a>
        <a href="/diagnostic/symptomes/voyant-moteur-sans-perte-performance" class="flex items-center gap-3 p-4 bg-slate-800/50 hover:bg-slate-800 rounded-lg border border-slate-700 hover:border-accent-diagnostic transition-colors">
          <span class="text-accent-diagnostic text-xl">🚨</span>
          <span class="text-slate-200 font-medium">Voyant Moteur allumé</span>
        </a>
        <a href="/diagnostic/methodologie/comment-diagnostiquer-un-ecu-inaccessible-avant-de-le-remplacer" class="flex items-center gap-3 p-4 bg-slate-800/50 hover:bg-slate-800 rounded-lg border border-slate-700 hover:border-accent-diagnostic transition-colors">
          <span class="text-accent-diagnostic text-xl">💻</span>
          <span class="text-slate-200 font-medium">ECU Inaccessible</span>
        </a>
        <a href="/diagnostic/methodologie/comment-diagnostiquer-un-defaut-can-bus-etape-par-etape" class="flex items-center gap-3 p-4 bg-slate-800/50 hover:bg-slate-800 rounded-lg border border-slate-700 hover:border-accent-diagnostic transition-colors">
          <span class="text-accent-diagnostic text-xl">📡</span>
          <span class="text-slate-200 font-medium">Plusieurs calculateurs absents (CAN)</span>
        </a>
        <a href="/diagnostic/methodologie/comment-diagnostiquer-une-consommation-parasite-de-batterie" class="flex items-center gap-3 p-4 bg-slate-800/50 hover:bg-slate-800 rounded-lg border border-slate-700 hover:border-accent-diagnostic transition-colors">
          <span class="text-accent-diagnostic text-xl">🔋</span>
          <span class="text-slate-200 font-medium">La batterie se décharge</span>
        </a>
        <a href="/diagnostic/symptomes/moteur-broute-a-chaud" class="flex items-center gap-3 p-4 bg-slate-800/50 hover:bg-slate-800 rounded-lg border border-slate-700 hover:border-accent-diagnostic transition-colors">
          <span class="text-accent-diagnostic text-xl">💥</span>
          <span class="text-slate-200 font-medium">Ratés moteur / Broutements</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Piliers Section (12 Catégories) -->
  <section class="py-12 border-t border-slate-800">
    <h2 class="text-2xl md:text-3xl font-heading font-bold text-white mb-8 text-center">Les 12 Hubs Techniques</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-7xl mx-auto">
      
      <a href="/diagnostic/symptomes" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors flex items-center gap-2"><span>🔍</span> Diagnostic</h3>
        <p class="text-sm text-slate-400">Diagnostic par symptômes (calage, broutement, pertes de puissance).</p>
      </a>

      <a href="/diagnostic/methodologie" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors flex items-center gap-2"><span>🧪</span> Guides de Test</h3>
        <p class="text-sm text-slate-400">Comment tester un PMH, un relais, un actionneur, une masse ECU.</p>
      </a>

      <a href="/diagnostic/livedata" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors flex items-center gap-2"><span>📊</span> Live Data</h3>
        <p class="text-sm text-slate-400">Interpréter STFT/LTFT, MAF, MAP, pressions et corrections d'injecteurs.</p>
      </a>

      <a href="/diagnostic/electricite" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors flex items-center gap-2"><span>🔌</span> Électricité & Faisceaux</h3>
        <p class="text-sm text-slate-400">Voltage drop, chutes de tension, masses et défauts d'alimentation.</p>
      </a>

      <a href="/diagnostic/can" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors flex items-center gap-2"><span>📡</span> CAN Bus</h3>
        <p class="text-sm text-slate-400">Mesure des 60 Ω, U-codes, réseaux ouverts ou en court-circuit.</p>
      </a>

      <a href="/diagnostic/capteurs" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors flex items-center gap-2"><span>🎛️</span> Capteurs</h3>
        <p class="text-sm text-slate-400">Mesure des alimentations, masses, signaux 5V, et courbes à l'oscilloscope.</p>
      </a>

      <a href="/diagnostic/actionneurs" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors flex items-center gap-2"><span>⚙️</span> Actionneurs</h3>
        <p class="text-sm text-slate-400">Résistance, commande PWM, et diagnostics via Active Test.</p>
      </a>

      <a href="/programmation/ecu" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-programmation transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-programmation transition-colors flex items-center gap-2"><span>💻</span> ECU & Programmation</h3>
        <p class="text-sm text-slate-400">OBD, Bench, Boot, Flash, clonage de calculateurs et codage.</p>
      </a>

      <a href="/programmation/immo" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-programmation transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-programmation transition-colors flex items-center gap-2"><span>🔐</span> EEPROM / IMMO / Clés</h3>
        <p class="text-sm text-slate-400">Désynchronisation, perte de clés, Virginisation, et BSI/UCH/CAS.</p>
      </a>

      <a href="/outils" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-programmation transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-programmation transition-colors flex items-center gap-2"><span>🛠️</span> Outils & Matériel</h3>
        <p class="text-sm text-slate-400">Scanners, oscilloscopes, programmateurs. Bien s'équiper.</p>
      </a>

      <a href="/diagnostic/casreels" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors flex items-center gap-2"><span>📚</span> Cas Réels</h3>
        <p class="text-sm text-slate-400">Études de cas pointues. Le symptôme, les hypothèses et la réparation.</p>
      </a>

      <a href="/diagnostic/dtc" class="group block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-diagnostic transition-colors shadow-sm">
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-accent-diagnostic transition-colors flex items-center gap-2"><span>⚠️</span> DTC</h3>
        <p class="text-sm text-slate-400">Codes défauts décortiqués : causes profondes et tests spécifiques.</p>
      </a>

    </div>
  </section>

  <!-- Ajouts Récents -->
  <section class="py-12 border-t border-slate-800">
    <div class="flex justify-between items-end mb-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-white">Guides Récents</h2>
      <a href="/recherche" class="text-sm text-accent-diagnostic hover:underline">Recherche avancée →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {allArticles.map(article => (
        <a href={`/diagnostic/${article.collection}/${article.id}`} class="block p-5 bg-surface border border-slate-800 rounded-xl hover:border-slate-500 transition-colors flex flex-col h-full">
          <div class="text-xs text-slate-500 mb-2 uppercase tracking-wider">{article.collection}</div>
          <h3 class="text-md font-bold text-white mb-2 leading-snug">{article.data.title}</h3>
          <p class="text-sm text-slate-400 line-clamp-3 mt-auto">{article.data.description}</p>
        </a>
      ))}
    </div>
  </section>

</BaseLayout>
