---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { generateSchemaOrg } from '../../utils/seo';

export async function getStaticPaths() {
  const outilsEntries = await getCollection('outils');
  return outilsEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { 
  name, brand, description, niveauUtilisateur, 
  ceQuilPermet, ceQuilNePermetPas, 
  avantages, limites, ratings, verdict 
} = entry.data;

const schema = generateSchemaOrg('Product', entry.data);

const paths = [
  { label: 'Outils', url: '/outils' },
  { label: name, url: '#' }
];
---
<BaseLayout title={`${name} - Test et Avis | DiagVault`} description={description} schema={schema}>
  <div class="max-w-4xl mx-auto">
    <Breadcrumbs paths={paths} />
    
    <header class="mb-10 p-8 bg-surface border border-slate-800 rounded-2xl relative overflow-hidden">
      <div class="absolute top-0 right-0 p-4">
        <span class="px-3 py-1 bg-accent-programmation/20 text-accent-programmation border border-accent-programmation/30 rounded-full text-xs font-bold uppercase tracking-wider">{brand}</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-heading font-bold text-white mb-4">{name}</h1>
      <p class="text-xl text-slate-400 mb-6">{description}</p>
      
      <div class="flex gap-4 items-center">
        <div class="text-sm px-3 py-1 bg-slate-800 text-slate-300 rounded border border-slate-700">
          Niveau : <span class="capitalize font-bold text-white">{niveauUtilisateur}</span>
        </div>
      </div>
    </header>

    <div class="grid md:grid-cols-2 gap-6 mb-10">
      <div class="bg-green-900/10 border border-green-800/30 rounded-xl p-6">
        <h3 class="text-green-400 font-bold mb-4 font-heading flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Ce qu'il permet
        </h3>
        <ul class="space-y-2 text-slate-300 text-sm">
          {ceQuilPermet.map((item: string) => (
            <li class="flex items-start gap-2">
              <span class="text-green-500 mt-1">•</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-red-900/10 border border-red-800/30 rounded-xl p-6">
        <h3 class="text-red-400 font-bold mb-4 font-heading flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          Ce qu'il NE permet PAS
        </h3>
        <ul class="space-y-2 text-slate-300 text-sm">
          {ceQuilNePermetPas.map((item: string) => (
            <li class="flex items-start gap-2">
              <span class="text-red-500 mt-1">•</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <article class="prose prose-invert prose-headings:font-heading prose-headings:text-white prose-a:text-accent-diagnostic max-w-none">
      <Content />
      
      <h2>Verdict</h2>
      <div class="p-6 bg-surface border border-slate-700 rounded-lg">
        <p class="text-lg font-bold text-white m-0">{verdict}</p>
      </div>
    </article>
  </div>
</BaseLayout>
