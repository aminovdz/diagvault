---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';

let entries: any[] = [];
try {
  const coll = await getCollection('outils');
  if (coll) entries = coll;
} catch(e) {
  // Ignorer
}

const paths = [
  { label: 'Outils & Matériel', url: '#' }
];
---

<BaseLayout title="Outils & Matériel de Diagnostic - DiagVault">
  <div class="max-w-4xl mx-auto">
    <Breadcrumbs paths={paths} />
    
    <header class="mb-10">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-4">
        Outils & Matériel
      </h1>
      <p class="text-xl text-slate-400">
        Scanners, oscilloscopes, programmateurs. Tests, avis et comparatifs.
      </p>
    </header>

    <div class="grid md:grid-cols-2 gap-6">
      {entries.length > 0 ? (
        entries.map(entry => (
          <a href={`/outils/${entry.id}`} class="block p-6 bg-surface border border-slate-800 rounded-xl hover:border-accent-programmation transition-colors group">
            <div class="flex justify-between items-start mb-2">
               <h2 class="text-2xl font-bold text-white group-hover:text-accent-programmation transition-colors">{entry.data.name}</h2>
               <span class="text-xs bg-slate-800 text-slate-300 px-2 py-1 rounded">{entry.data.brand}</span>
            </div>
            <p class="text-slate-400 text-sm mb-4">{entry.data.description}</p>
            <div class="mt-4 pt-4 border-t border-slate-800 flex justify-between text-sm">
               <span class="text-slate-500">Verdict Qualité/Prix</span>
               <span class="text-accent-programmation font-bold">{entry.data.ratings?.qualitePrix}/5</span>
            </div>
          </a>
        ))
      ) : (
        <div class="col-span-2 p-8 bg-surface border border-slate-800 rounded-xl text-center">
          <p class="text-slate-400">Aucun outil n'a encore été testé.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
